set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

RUNTIME_PASSWD="$(/usr/bin/getent passwd aiuser 2>/dev/null || true)"
RUNTIME_UID="$(printf '%s\n' "$RUNTIME_PASSWD" | /usr/bin/cut -d: -f3)"
CANONICAL_HOME="$(printf '%s\n' "$RUNTIME_PASSWD" | /usr/bin/cut -d: -f6)"
if [[ ! "$RUNTIME_UID" =~ ^[1-9][0-9]*$ ||
      "$(/usr/bin/id -u)" != "$RUNTIME_UID" ||
      "${VANTAGE_DISPATCHED:-0}" != 1 ||
      "$CANONICAL_HOME" != /* || "$CANONICAL_HOME" == / ||
      "${HOME:-}" != "$CANONICAL_HOME" ]]; then
  echo "CMS scanner tools must run as aiuser inside a dispatched CMS scan" >&2
  exit 77
fi

WRAPPER_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="$(cd -- "${WRAPPER_DIR}/.." && pwd -P)"
if [[ -f "${WRAPPER_DIR}/../run_cms_scanner.sh" && -d "${WRAPPER_DIR}/../tools" ]]; then
  PROJECT_ROOT="$(cd -- "${WRAPPER_DIR}/.." && pwd -P)"
fi

CANONICAL_VENV="${CANONICAL_HOME}/.local/share/vantage/cms_scanner/venv"
CANONICAL_PYTHON="${CANONICAL_VENV}/bin/python"
export VIRTUAL_ENV="${CANONICAL_VENV}"
export PATH="${CANONICAL_VENV}/bin:${PATH}"

cd "${PROJECT_ROOT}/tools/.compat/clusterd-src" && exec env PYTHONWARNINGS=ignore::SyntaxWarning PYTHONPATH="${PROJECT_ROOT}/tools/.compat/clusterd-src/src:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/module:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/module/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/tomcat:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/tomcat/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/tomcat/fingerprints:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/tomcat/deployers:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/tomcat/auxiliary:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/weblogic:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/weblogic/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/weblogic/fingerprints:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/weblogic/deployers:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/weblogic/auxiliary:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/jboss:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/jboss/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/jboss/fingerprints:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/jboss/deployers:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/jboss/auxiliary:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/jboss/auxiliary/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/glassfish:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/glassfish/fingerprints:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/glassfish/deployers:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/glassfish/auxiliary:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/axis2:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/axis2/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/axis2/fingerprints:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/axis2/deployers:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/axis2/auxiliary:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/axis2/auxiliary/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/railo:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/railo/fingerprints:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/railo/deployers:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/railo/auxiliary:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/railo/auxiliary/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/coldfusion:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/coldfusion/fingerprints:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/coldfusion/deployers:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/coldfusion/auxiliary:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/platform/coldfusion/auxiliary/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/core:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/core/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/__pycache__:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/jboss:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/jboss/webconsole_deploy:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/jboss/jmxinvoke_deploy:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/jboss/bsh_deploy:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/axis2:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/railo:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/railo/railopass:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/coldfusion:${PROJECT_ROOT}/tools/.compat/clusterd-src/src/lib/resources:${PYTHONPATH:-}" "${CANONICAL_PYTHON}" "${PROJECT_ROOT}/tools/.compat/clu